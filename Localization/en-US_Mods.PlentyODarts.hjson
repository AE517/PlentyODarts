DamageClasses.DartDamage.DisplayName: Dart Damage

Items: {
	WoodenDart: {
		DisplayName: Wooden Dart
		Tooltip: '''[c/69B595:"The classic, Good and Reliable"]'''
	}

	StarryDart: {
		DisplayName: Starry Dart
		Tooltip:
			'''
			Critical hits makes a star fall from the sky...
			Yes, even at daytime...

			[c/69B595:"A fragment of the stars"]
			'''
	}

	PoisonDart: {
		DisplayName: Poison Dart
		Tooltip:
			'''
			Critical Hits leaves the target poisoned regardless of immunities.

			[c/69B595:"It Stings!"]
			'''
	}

	FrostDart: {
		DisplayName: Frost Dart
		Tooltip:
			'''
			Critical Hits inflicts Frostburn regardless of target immunities.
			Fades quickly in hot environments...
			[c/69B595:"Chilly... Extra Chilly..."]
			'''
	}

	FieryDart: {
		DisplayName: Fiery Dart
		Tooltip:
			'''
			Critical Hits renders the target on fire regardless of immunities.
			[c/69B595: "Hot! HOT!!!"]
			'''
	}

	GlassDart: {
		DisplayName: Glass Dart
		Tooltip:
			'''
			Critical Hits inflicts Bleeding regardless of target immunities. 
			Additionally, upon hitting the ground or inflicting critical hits,
			an unpredictable amount of shards will spread causing damage to ANYONE
			around, also inflicting bleeding.
			Shards do bonus damage to already bleeding targets.

			[c/69B595:"Now why would even use such thing???"]
			'''
	}

	Split: {
		DisplayName: Modus - Split
		Tooltip:
			'''
			Alters the properties of the equiped Dart allowing to split itself at opposing directions.
			Only one type of 'Modus' can be equiped.

			[c/69B595:"The duality of Darts..."]
			'''
	}

	HyperSpeed: {
		DisplayName: Shift - Hyperspeed
		Tooltip:
			'''
			Increase overral Dart Speed at the cost of it's Damage.
			Only one type of 'Shift' can be equipped.

			[c/69B595:"ZOOOOOOOM!"]
			'''
	}

	DartStationBasic: {
		DisplayName: Basic Dart Station
		Tooltip:
			'''
			Can be used to make more complex darts.

			[c/69B595:"Every Dartmaster has a certain kind of industriousness..."]
			'''
	}

	OceanDart: {
		DisplayName: Ocean Dart
		Tooltip:
			'''
			A Dart made with the combined forces of the ocean.
			Primary use: Throws a watery Dart that renders the target wet regardless of immunities.
			Secondary use: Throws a fiery Dart that on contact with wet targets
			will create an explosion dealing extra damage.
			Enimies hit by the explosion will no longer be wet.
			Both Darts travel faster and deal extra damage on rain and underwater.

			[c/42CF6A:This Dart is not affected by Modus nor Shifts.]

			[c/69B595:"You exceeded my expectations with this one..."]
			'''
	}

	Aurpura: {
		DisplayName: Aurpura
		Tooltip:
			'''
			Throws a Dark Golden Dart that on collision will launch another golden dart at the nearest enemy.
			Aurpura can pierce one enemy before breaking, the golden dart goes after it's target regardless of
			terrain.
			Critical hits makes Aurpura target one additional enemy.

			[c/69B595:"Truly a very elegant combination..."]
			'''
	}

	Marnum: {
		DisplayName: Marnum
		Tooltip:
			'''
			Throws a Marbled Platinum Dart that will bounce on terrain.
			Upon hitting enemies it will dissapear creating a bouncy after-image.

			[c/69B595:"Makes me wonder... Can ghosts throw darts too?"]
			'''
	}
}

